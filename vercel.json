{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm --prefix server install && npm --prefix client install",
  "buildCommand": "npm --prefix server run build && npm --prefix client run build",
  "outputDirectory": "client/dist",
  "functions": {
    "api/index.mjs": {
      "maxDuration": 60,
      "memory": 1024,
      "includeFiles": "server/node_modules/better-sqlite3/build/Release/*.node"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
